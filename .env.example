# API Configuration
REACT_APP_API_URL=https://api.predictionsapp.com/v1

# Site Configuration
REACT_APP_SITE_URL=https://predictionsapp.com
REACT_APP_SITE_NAME=PredictionsApp

# Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Error Tracking
REACT_APP_SENTRY_DSN=your_sentry_dsn

# Feature Flags
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_OFFLINE_MODE=true

# External Services
REACT_APP_TELEGRAM_BOT_NAME=predictionsapp_bot
REACT_APP_DISCORD_INVITE=predictionsapp
REACT_APP_TWITTER_HANDLE=predictionsapp

# Development
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false