# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Node / frontend build
node_modules/
frontend/dist/
frontend/dist-ssr/

# Python / backend
__pycache__/
*.py[cod]
backend/venv*/
.venv/
backend/htmlcov/
# Coverage artefacts land wherever pytest was invoked from, so both the backend directory and
# the repository root can hold one.
backend/.coverage
.coverage
backend/.pytest_cache/
.mypy_cache/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Logs and local tooling output
*.log
.trunk/

# Local database backups (may contain credentials/PII) - never commit
backups/

# Playwright artifacts. Screenshots are regenerable evidence, not source: they were 9 MB after one
# before/after comparison, and this repository is public.
frontend/e2e/screenshots/
frontend/e2e/.artifacts/
frontend/e2e/.report/
frontend/test-results/
