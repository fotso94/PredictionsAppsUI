# Environment Configuration
# Copy this file to .env and update with your values

# Application
PROJECT_NAME="Soccer Predictions Platform API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# Security
SECRET_KEY="your-secret-key-change-in-production-use-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
REFRESH_TOKEN_EXPIRE_MINUTES=43200  # 30 days
ALGORITHM="HS256"

# CORS - Allowed Origins (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Allowed Hosts (for production)
ALLOWED_HOSTS="localhost,127.0.0.1"

# Database - PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres123"
POSTGRES_DB="soccer_predictions"
# DATABASE_URL will be auto-generated if not provided
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/soccer_predictions"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# REDIS_URL will be auto-generated if not provided
# REDIS_URL="redis://localhost:6379/0"

# Redis Database Allocation (from KAN-30)
REDIS_DB_SESSIONS=0  # User sessions and authentication
REDIS_DB_PREDICTIONS=1  # Prediction caching
REDIS_DB_EXPERT_TOOLS=2  # Expert tools cache
REDIS_DB_ML_MODELS=3  # ML model predictions cache
REDIS_DB_MATCH_DATA=4  # Real-time match data
REDIS_DB_RATE_LIMIT=5  # API rate limiting

# Email Configuration
EMAIL_PROVIDER="smtp"  # smtp, sendgrid, or ses
EMAIL_ENABLED=true

# SMTP Configuration (for Gmail, Mailtrap, etc.)
SMTP_HOST="smtp.gmail.com"  # or smtp.mailtrap.io for development
SMTP_PORT=587  # 587 for TLS, 465 for SSL, 2525 for Mailtrap
SMTP_TLS=true
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
EMAILS_FROM_EMAIL="noreply@soccerpredictions.com"
EMAILS_FROM_NAME="Soccer Predictions Platform"

# SendGrid Configuration (future use)
SENDGRID_API_KEY=""

# AWS SES Configuration (future use)
AWS_SES_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Email Templates
EMAIL_TEMPLATES_DIR="app/templates/emails"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"

# External APIs
API_FOOTBALL_KEY=""
THESPORTSDB_KEY="773015"

# ML/AI Configuration
ML_MODEL_PATH="/app/ml/models"
ML_ENABLED=true

# Feature Flags
EXPERT_TOOLS_ENABLED=true
ADMIN_FEATURES_ENABLED=true

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or text

# First Superuser (for initialization)
FIRST_SUPERUSER_EMAIL="admin@soccerpredictions.com"
FIRST_SUPERUSER_PASSWORD="changeme123"

