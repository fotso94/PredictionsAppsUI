== (3) the helper: frontend/e2e/support/qa-account.ts lines 174-187
 174  export async function anyUpcomingMatch(api: APIRequestContext): Promise<ApiMatch | null> {
 175    for (let offset = 0; offset < 8; offset += 1) {
 176      const day = new Date();
 177      day.setUTCDate(day.getUTCDate() + offset);
 178      const iso = day.toISOString().slice(0, 10);
 179      // refresh=false keeps this a database read: no provider request is made
 180      const response = await api.get(`/api/v1/matches?date=${iso}&refresh=false`);
 181      if (!response.ok()) continue;
 182      const body = await response.json();
 183      const upcoming = (body.matches || []).find((m: ApiMatch) => m.status === 'scheduled');
 184      if (upcoming) return upcoming;
 185    }
 186    return null;
 187  }
