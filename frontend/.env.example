# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Environment
VITE_ENV=development

# API-Football (https://www.api-football.com) key, used ONLY by the Vite dev proxy
# (see vite.config.ts) to add the x-apisports-key header on the dev server.
# No VITE_ prefix on purpose: this value must never reach the browser bundle.
API_FOOTBALL_KEY=

# INSECURE opt-in for local demos only: a VITE_-prefixed key is embedded in the public
# bundle and sent from the browser in production builds. Leave it empty.
# VITE_API_FOOTBALL_KEY=

# Data source for fixtures, standings and predictions
# backend (default): FastAPI /api/v1/matches, /leagues, /teams (Live Score API + GameForecastAPI server-side)
# api-football: legacy browser-side API-Football path (retained integration; needs the dev proxy key above)
VITE_DATA_SOURCE=backend

# Legacy placeholder predictions/odds (random numbers) in the api-football path. Keep off.
# VITE_ALLOW_FAKE_PREDICTIONS=false

# TheSportsDB key for the retained browser-side fallback services (optional, "3" = free test key)
# VITE_THESPORTSDB_KEY=
